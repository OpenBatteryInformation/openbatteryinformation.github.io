{
  "name": "open-battery-information-desktop",
  "productName": "Open Battery Information",
  "version": "1.0.0",
  "description": "Desktop build of the Open Battery Information OBI-1 tool — native serial battery diagnosis for Windows, macOS and Linux.",
  "main": "main.js",
  "license": "GPL-3.0",
  "author": "Open Battery Information",
  "homepage": "https://github.com/OpenBatteryInformation/openbatteryinformation.github.io",
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "scripts": {
    "prepare:site": "node scripts/prepare-site.mjs",
    "start": "node scripts/prepare-site.mjs && electron .",
    "dist": "node scripts/prepare-site.mjs && electron-builder",
    "dist:win": "node scripts/prepare-site.mjs && electron-builder --win",
    "dist:mac": "node scripts/prepare-site.mjs && electron-builder --mac",
    "dist:linux": "node scripts/prepare-site.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
